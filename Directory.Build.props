<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1603;NU1901;NU1902;NU1903</WarningsNotAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>JasonXuDeveloper</Authors>
        <RepositoryUrl>https://github.com/JasonXuDeveloper/DaServer</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <EasyEcsVersion>4.0.1</EasyEcsVersion>
        <NinoVersion>4.0.0-beta.47</NinoVersion>
        <!-- Pre-1.0: the API may still change between minor versions. -->
        <Version>0.1.0</Version>
        <!-- NU5104: a release depending on a prerelease package (Nino 4 is in beta). -->
        <NoWarn>$(NoWarn);NU5104</NoWarn>
    </PropertyGroup>
</Project>
