<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1603;NU1901;NU1902;NU1903</WarningsNotAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>JasonXuDeveloper</Authors>
        <RepositoryUrl>https://github.com/JasonXuDeveloper/DaServer</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <!-- EasyEcs: use the sibling checkout when present (co-development), otherwise the NuGet package -->
        <EasyEcsProject>$(MSBuildThisFileDirectory)../EasyEcs/EasyEcs.Core/EasyEcs.Core.csproj</EasyEcsProject>
        <EasyEcsGeneratorProject>$(MSBuildThisFileDirectory)../EasyEcs/EasyEcs.Generator/EasyEcs.Generator.csproj</EasyEcsGeneratorProject>
        <EasyEcsVersion>4.0.0</EasyEcsVersion>
        <NinoVersion>4.0.0-beta.47</NinoVersion>
    </PropertyGroup>
</Project>
