<Project>
    <!-- Shared by the sample's node projects: a node hosts every actor, service and system compiled into its project.
         No Program.cs: the DaServer generator emits the entry point (Generic Host + AddDaServer). -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <TieredPGO>true</TieredPGO>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\DaServer.Hosting\DaServer.Hosting.csproj" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)Sample.Contracts\Sample.Contracts.csproj" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\DaServer.Generator\DaServer.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="$(EasyEcsGeneratorProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="Exists('$(EasyEcsGeneratorProject)')" />
    </ItemGroup>
</Project>
