        <IsPackable>false</IsPackable>
        <UserSecretsId>daserver-flashsale-apphost</UserSecretsId>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
