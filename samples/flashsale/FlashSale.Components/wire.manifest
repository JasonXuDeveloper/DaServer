# DaServer wire manifest (ADR-076): the layout of this assembly's [NinoType] types on the wire and in stored records.
# 'grows' types (value fields only, whole messages, replies, records) may append fields, 'frozen' ones may not change. Update: dotnet build -p:UpdateWireManifest=true
FlashSale.Components.Purchase grows
- Status: FlashSale.Contracts.OrderStatus(byte)
FlashSale.Components.SaleState frozen
- PerSecond: int
- Issued: long
- Released: long
- AtMs: long
- EmptyShards: int
- Buyers: System.Collections.Generic.List<long>
FlashSale.Components.Stock frozen
- Left: int
- Buyers: System.Collections.Generic.List<long>
