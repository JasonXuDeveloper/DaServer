<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <UserSecretsId>daserver-sample-apphost</UserSecretsId>
        <!-- The sample runs through `dotnet run`; the Aspire CLI bundle is optional. -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
        <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.1" />
        <PackageReference Include="Aspire.Hosting.Kubernetes" Version="13.6.1-preview.1.26506.6" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\DaServer.Aspire\DaServer.Aspire.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\Sample.GameServer\Sample.GameServer.csproj" />
        <ProjectReference Include="..\Sample.GatewayServer\Sample.GatewayServer.csproj" />
        <ProjectReference Include="..\Sample.LoginServer\Sample.LoginServer.csproj" />
        <ProjectReference Include="..\Sample.MapServer\Sample.MapServer.csproj" />
        <ProjectReference Include="..\Sample.Bot\Sample.Bot.csproj" />
    </ItemGroup>

</Project>
