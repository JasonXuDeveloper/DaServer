<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.1: contract assemblies shared with Unity and other .NET clients. -->
        <TargetFrameworks>netstandard2.1;net11.0</TargetFrameworks>
        <RootNamespace>DaServer</RootNamespace>
        <Description>DaServer contracts: message, handler and client attributes, requests, addresses, wire ids. Referenced by contract assemblies shared between servers and clients.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nino" />
    </ItemGroup>

    <!-- The generators and analyzers ship in this package, so every assembly using DaServer runs them. -->
    <ItemGroup>
        <!-- Two builds of the same sources, like Nino's: Roslyn 5.9 for current SDKs, Roslyn 4.3 for Unity and older
             compilers; NuGet gives each compiler the newest one it can run. -->
        <ProjectReference Include="..\DaServer.Generator\DaServer.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\DaServer.Generator.Roslyn4.3\DaServer.Generator.Roslyn4.3.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\DaServer.Generator\bin\$(Configuration)\netstandard2.0\DaServer.Generator.dll" Pack="true"
              PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
        <None Include="..\DaServer.Generator.Roslyn4.3\bin\$(Configuration)\netstandard2.0\DaServer.Generator.dll" Pack="true"
              PackagePath="analyzers/dotnet/roslyn4.3/cs" Visible="false" />
        <!-- The wire manifest's writer (dotnet build -p:UpdateWireManifest=true), run by the buildTransitive targets. Built
             with the solution's own global properties (no TargetFramework of ours): one instance, not two writing the same
             output in parallel. -->
        <ProjectReference Include="..\DaServer.WireTool\DaServer.WireTool.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                          SkipGetTargetFrameworkProperties="true" UndefineProperties="%3BTargetFramework" />
        <None Include="..\DaServer.WireTool\bin\$(Configuration)\net11.0\**\*.dll;..\DaServer.WireTool\bin\$(Configuration)\net11.0\*.json"
              Pack="true" PackagePath="tools" Visible="false" />
        <None Include="buildTransitive\DaServer.Abstractions.props" Pack="true" PackagePath="buildTransitive" />
        <None Include="buildTransitive\DaServer.Abstractions.targets" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>

    <!-- Newer BCL types this code uses, for netstandard2.1 only (internal; Core and Client see them as friends). -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <Compile Include="..\Polyfills\**\*.cs" LinkBase="Polyfills" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DaServer.Core" />
        <InternalsVisibleTo Include="DaServer.Client" />
        <InternalsVisibleTo Include="DaServer" />
        <InternalsVisibleTo Include="DaServer.Hosting" />
        <InternalsVisibleTo Include="DaServer.Testing" />
        <InternalsVisibleTo Include="DaServer.Tests" />
        <InternalsVisibleTo Include="DaServer.Benchmark" />
    </ItemGroup>

</Project>
