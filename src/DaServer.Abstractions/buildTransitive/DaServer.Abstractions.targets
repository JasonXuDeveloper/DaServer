<Project>
    <!-- Wire versioning (ADR-076): the committed wire.manifest is checked by the analyzer (DAS017/DAS018);
         dotnet build -p:UpdateWireManifest=true rewrites it from the built assembly (force: also when the change breaks peers). -->
    <PropertyGroup>
        <!-- What Nino skips silently would leave a value off the wire or out of a record: a read-only member it cannot
             restore (NINO006), a type it cannot write (NINO007), a hidden member it cannot reach (NINO022), a former name
             it ignores (NINO024). The wire manifest assumes none of them. -->
        <WarningsAsErrors>$(WarningsAsErrors);NINO006;NINO007;NINO022;NINO024</WarningsAsErrors>
        <_DaServerUpdatingManifest Condition="'$(UpdateWireManifest)' == 'true' or '$(UpdateWireManifest)' == 'force'">true</_DaServerUpdatingManifest>
        <_DaServerManifestFramework Condition="'$(TargetFrameworks)' != ''">$(TargetFrameworks.Split(';')[0].Trim())</_DaServerManifestFramework>
        <DaServerWireManifest Condition="'$(DaServerWireManifest)' == ''">$(MSBuildProjectDirectory)/wire.manifest</DaServerWireManifest>
        <DaServerWireTool Condition="'$(DaServerWireTool)' == ''">$(MSBuildThisFileDirectory)../tools/DaServer.WireTool.dll</DaServerWireTool>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(DaServerWireManifest)" Condition="Exists('$(DaServerWireManifest)')" />
        <!-- While the manifest is rewritten the analyzer reports only breaking changes (none with force). -->
        <CompilerVisibleProperty Include="UpdateWireManifest" />
    </ItemGroup>

    <!-- After a successful compile (a breaking change fails it first, unless forced), one target framework (the first)
         writes the manifest from the built assembly: the analyzer's own reading of Nino's layouts, from metadata. -->
    <!-- Test projects put nothing on a deployed wire: they keep no manifest (DaServerWireManifestSkip opts others out). -->
    <Target Name="DaServerUpdateWireManifest" AfterTargets="CoreCompile" DependsOnTargets="$(DaServerWireToolDependsOn)"
            Condition="'$(_DaServerUpdatingManifest)' == 'true' and '$(IsTestProject)' != 'true' and '$(DaServerWireManifestSkip)' != 'true' and
                       ('$(TargetFrameworks)' == '' or '$(_DaServerManifestFramework)' == '$(TargetFramework)')">
        <PropertyGroup>
            <_DaServerReferences>$(IntermediateOutputPath)DaServer.WireReferences.txt</_DaServerReferences>
        </PropertyGroup>
        <WriteLinesToFile File="$(_DaServerReferences)" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="dotnet exec &quot;$(DaServerWireTool)&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(_DaServerReferences)&quot; &quot;$(DaServerWireManifest)&quot;" />
    </Target>
</Project>
