<Project>
    <!-- Wire versioning (ADR-076): the committed wire.manifest is checked by the analyzer (DAS017/DAS018);
         dotnet build -p:UpdateWireManifest=true rewrites it from the code (force: also when the change breaks peers). -->
    <PropertyGroup>
        <_DaServerUpdatingManifest Condition="'$(UpdateWireManifest)' == 'true' or '$(UpdateWireManifest)' == 'force'">true</_DaServerUpdatingManifest>
        <_DaServerManifestFramework Condition="'$(TargetFrameworks)' != ''">$(TargetFrameworks.Split(';')[0].Trim())</_DaServerManifestFramework>
        <DaServerWireManifest Condition="'$(DaServerWireManifest)' == ''">$(MSBuildProjectDirectory)/wire.manifest</DaServerWireManifest>
        <EmitCompilerGeneratedFiles Condition="'$(_DaServerUpdatingManifest)' == 'true'">true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath Condition="'$(_DaServerUpdatingManifest)' == 'true' and '$(CompilerGeneratedFilesOutputPath)' == ''">$(IntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(DaServerWireManifest)" Condition="Exists('$(DaServerWireManifest)')" />
        <!-- While the manifest is rewritten the analyzer reports only breaking changes (none with force). -->
        <CompilerVisibleProperty Include="UpdateWireManifest" />
    </ItemGroup>

    <!-- Compile again even when up to date: the generated manifest is written by the compiler. -->
    <Target Name="DaServerRecompileForWireManifest" BeforeTargets="CoreCompile" Condition="'$(_DaServerUpdatingManifest)' == 'true'">
        <Delete Files="@(IntermediateAssembly)" />
    </Target>

    <!-- One target framework writes the file (the first one listed): inner builds run in parallel. -->
    <Target Name="DaServerUpdateWireManifest" AfterTargets="CoreCompile"
            Condition="'$(_DaServerUpdatingManifest)' == 'true' and ('$(TargetFrameworks)' == '' or '$(_DaServerManifestFramework)' == '$(TargetFramework)')">
        <ItemGroup>
            <_DaServerGeneratedManifest Include="$(CompilerGeneratedFilesOutputPath)/**/DaServer.WireManifest.g.cs" />
        </ItemGroup>
        <PropertyGroup>
            <_DaServerGeneratedPath>@(_DaServerGeneratedManifest)</_DaServerGeneratedPath>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_DaServerGeneratedPath)' != ''">
            <_DaServerManifest>$([System.IO.File]::ReadAllText('$(_DaServerGeneratedPath)'))</_DaServerManifest>
            <_DaServerManifest>$(_DaServerManifest.Substring($([MSBuild]::Add($(_DaServerManifest.IndexOf('/*')), 3))))</_DaServerManifest>
            <_DaServerManifest>$(_DaServerManifest.Substring(0, $(_DaServerManifest.LastIndexOf('*/'))).TrimEnd())</_DaServerManifest>
        </PropertyGroup>
        <WriteLinesToFile File="$(DaServerWireManifest)" Lines="$(_DaServerManifest)" Overwrite="true" WriteOnlyWhenDifferent="true"
                          Condition="'$(_DaServerManifest)' != ''" />
    </Target>
</Project>
