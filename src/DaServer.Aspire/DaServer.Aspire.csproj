<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Description>Aspire hosting integration: declare a DaServer cluster in an AppHost (node groups, client endpoints, seeds, ports) and run or publish it.</Description>
        <RootNamespace>Aspire.Hosting</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" />
        <PackageReference Include="Aspire.Hosting.Docker" />
        <PackageReference Include="Aspire.Hosting.Kubernetes" />
        <PackageReference Include="MessagePack" />
    </ItemGroup>

    <ItemGroup>
        <!-- The route rules (A11) over the routes node projects list: the same file the runtime's RouteCheck uses. -->
        <Compile Include="..\DaServer\Runtime\RouteRules.cs" Link="RouteRules.cs" />
        <!-- The admin token (A5) its dashboard commands send: the derivation the nodes check. -->
        <Compile Include="..\DaServer.Hosting\AdminToken.cs" Link="AdminToken.cs" />
    </ItemGroup>

</Project>
