<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net11.0</TargetFrameworks>
        <RootNamespace>DaServer.Client</RootNamespace>
        <Description>DaServer client SDK (games, bots, tools; Unity through netstandard2.1): connects to client-facing nodes, sends [FromClient] messages, handles [ToClient] ones, reconnects and resumes its session.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaServer.Core\DaServer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DaServer.Tests" />
        <InternalsVisibleTo Include="DaServer.Benchmark" />
    </ItemGroup>

</Project>
