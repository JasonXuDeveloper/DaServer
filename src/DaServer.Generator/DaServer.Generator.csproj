<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Roslyn hosts (VS, Rider, MSBuild) load generators as netstandard2.0 -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);RS2008</NoWarn>
        <!-- No wire types; the manifest writer is built on it (writing its manifest would build the writer in a cycle). -->
        <DaServerWireManifestSkip>true</DaServerWireManifestSkip>
    </PropertyGroup>

    <ItemGroup>
        <!-- The manifest's writer runs the analyzer's own WireManifest over a built assembly. -->
        <InternalsVisibleTo Include="DaServer.WireTool" />
        <InternalsVisibleTo Include="DaServer.Tests" />
    </ItemGroup>

    <!-- Built against the newest Roslyn on NuGet (5.9: the .NET 10.0.4xx and .NET 11 SDKs load it); packed into
         analyzers/dotnet/roslyn5.9/cs. The same sources built against Roslyn 4.3 (DaServer.Generator.Roslyn4.3) serve
         Unity and older compilers: NuGet loads the newest build a compiler can run. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all"/>
    </ItemGroup>

</Project>
