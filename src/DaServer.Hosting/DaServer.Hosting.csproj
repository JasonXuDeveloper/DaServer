<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Description>DaServer integration with the .NET Generic Host and ASP.NET Core: configuration, logging, graceful shutdown, metrics, the HTTP plane.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- The HTTP plane (ADR-046): every node runs Kestrel next to its TCP data plane. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <!-- Service defaults for the HttpClients nodes make (what Aspire's ServiceDefaults template adds). -->
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Nino.AspNetCore" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaServer\DaServer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DaServer.Tests" />
    </ItemGroup>

</Project>
