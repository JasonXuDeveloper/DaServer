<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Its batch calls use pooled builders (one per batch, allocation-free), which runtime async ignores: IO-bound,
             it gains nothing from it. -->
        <UseRuntimeAsync>false</UseRuntimeAsync>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>DaServer.Persistence</RootNamespace>
        <Description>PostgreSQL store of DaServer actor records: one row per actor, batched loads, batched versioned writes.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Npgsql" Version="13.6.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaServer.Hosting\DaServer.Hosting.csproj" />
    </ItemGroup>

</Project>
