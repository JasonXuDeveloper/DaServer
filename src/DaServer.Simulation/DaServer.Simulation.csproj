<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>DaServer.Simulation</RootNamespace>
        <Description>Simulated users for DaServer clusters (end-to-end, load and behavior tests of any domain): client worlds on their own threads, HTN planning as ECS data, and swarms that connect, measure and judge thousands of clients. Client side only: it runs against any cluster.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaServer.Client\DaServer.Client.csproj" />
        <PackageReference Include="EasyEcs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DaServer.Tests" />
    </ItemGroup>

</Project>
