<Project Sdk="Microsoft.NET.Sdk">

    <!-- Writes a project's wire.manifest from its built assembly (dotnet build -p:UpdateWireManifest=true, ADR-076).
         Analyzers cannot write files and generators cannot see Nino's generated layouts: the manifest is read from the
         assembly after it is compiled, by the analyzer's own code (WireManifest). Ships in the Abstractions package. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>Major</RollForward>
        <IsPackable>false</IsPackable>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- The tool itself has no wire types; writing its manifest would run it while it is being built. -->
        <DaServerWireManifestSkip>true</DaServerWireManifestSkip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <ProjectReference Include="..\DaServer.Generator\DaServer.Generator.csproj" />
    </ItemGroup>

</Project>
