<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- Tests intentionally exercise edge cases (stale refs, error paths) -->
        <NoWarn>$(NoWarn);CS1591;NUnit2045</NoWarn>
        <!-- Allocation tests measure what users ship: unoptimized builds turn every async state machine into a class
             allocated per call, which would hide (or fake) real allocations behind pooled builders. -->
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="NUnit.Analyzers" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <!-- Nino's generator, run on in-memory compilations so the wire manifest tests read its layouts. -->
        <PackageReference Include="Nino.Generator" GeneratePathProperty="true" />
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NinoGenerator</_Parameter1>
            <_Parameter2>$(PkgNino_Generator)/analyzers/dotnet/roslyn4.12/cs/Nino.Generator.dll</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaServer.Tests.Components\DaServer.Tests.Components.csproj" />
        <ProjectReference Include="..\..\src\DaServer\DaServer.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Client\DaServer.Client.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Simulation\DaServer.Simulation.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Hosting\DaServer.Hosting.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Persistence.PostgreSql\DaServer.Persistence.PostgreSql.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Testing\DaServer.Testing.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Generator\DaServer.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    </ItemGroup>

</Project>
