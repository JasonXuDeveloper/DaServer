<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- Tests intentionally exercise edge cases (stale refs, error paths) -->
        <NoWarn>$(NoWarn);CS1591;NUnit2045</NoWarn>
        <!-- Allocation tests measure what users ship: unoptimized builds turn every async state machine into a class
             allocated per call, which would hide (or fake) real allocations behind pooled builders. -->
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaServer.Tests.Components\DaServer.Tests.Components.csproj" />
        <ProjectReference Include="..\..\src\DaServer\DaServer.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Client\DaServer.Client.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Simulation\DaServer.Simulation.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Hosting\DaServer.Hosting.csproj" />
        <ProjectReference Include="..\..\src\DaServer.Generator\DaServer.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    </ItemGroup>

</Project>
